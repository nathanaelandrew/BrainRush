@inherits LayoutComponentBase

<a href="#main" class="skip">Skip to content</a>

<div class="flex min-h-dvh">
    <NavMenu />

    <div class="flex min-w-0 flex-1 flex-col">
        <main id="main" class="mx-auto w-full max-w-7xl flex-1 px-10 pb-20 pt-10">
            @Body
        </main>

        <footer class="border-t border-line">
            <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-10 py-6 text-xs text-muted">
                <p><span class="font-bold text-fg">BrainRush</span> · Timed trivia battles</p>
                <p class="font-mono uppercase tracking-[0.14em]">Movies · Music · Sports · Gaming · General · Sample data only</p>
            </div>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>Something broke on our side. Reload to get back in the game.</span>
    <span><a href="." class="reload underline">Reload</a> <span class="dismiss" aria-label="Dismiss">✕</span></span>
</div>